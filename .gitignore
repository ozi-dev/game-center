# Public source allowlist. Personal installations and build output stay local.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/.github/**
!/README.md
!/LICENSE.txt
!/THIRD-PARTY.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/SECURITY.md
!/Build.ps1
!/Package.ps1
!/src/
!/src/**
!/scripts/
!/scripts/**
!/tests/
!/tests/**
!/manifests/
!/manifests/**
!/docs/
!/docs/**
!/assets/
!/assets/**
!/locales/
!/locales/**
assets/plugin/*.dll
assets/plugin/*.exe
src/*.dll
src/*.exe
tests/*.dll
tests/*.exe
**/__pycache__/
**/*.pyc
docs/private/
scripts/maintainer/local-*
